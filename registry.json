{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "acongm-ui",
  "homepage": "https://github.com/Acongm/shadcn-ui",
  "items": [
    {
      "name": "acongm-theme",
      "type": "registry:theme",
      "title": "Acongm Theme",
      "description": "Shared semantic light/dark design tokens for Acongm applications.",
      "cssVars": {
        "light": {
          "background": "#f7f8fa",
          "foreground": "#1a1d27",
          "card": "#ffffff",
          "card-foreground": "#1a1d27",
          "popover": "#ffffff",
          "popover-foreground": "#1a1d27",
          "primary": "#2f6b4f",
          "primary-foreground": "#ffffff",
          "secondary": "#eef1f5",
          "secondary-foreground": "#25283a",
          "muted": "#eef1f5",
          "muted-foreground": "#6b7280",
          "accent": "#e6f3ec",
          "accent-foreground": "#24543f",
          "destructive": "#c62828",
          "destructive-foreground": "#ffffff",
          "border": "#e4e7ef",
          "input": "#d4d8e3",
          "ring": "#2f6b4f",
          "radius": "0.75rem"
        },
        "dark": {
          "background": "#12141c",
          "foreground": "#e8eaef",
          "card": "#1a1d27",
          "card-foreground": "#e8eaef",
          "popover": "#1a1d27",
          "popover-foreground": "#e8eaef",
          "primary": "#3eaf7c",
          "primary-foreground": "#0b1f16",
          "secondary": "#222633",
          "secondary-foreground": "#e8eaef",
          "muted": "#222633",
          "muted-foreground": "#9aa3b5",
          "accent": "#20392d",
          "accent-foreground": "#bcebd4",
          "destructive": "#ef6b6b",
          "destructive-foreground": "#2a0b0b",
          "border": "#2c3140",
          "input": "#3a4052",
          "ring": "#3eaf7c"
        }
      }
    },
    {
      "name": "ui-cn",
      "type": "registry:lib",
      "title": "UI className utility",
      "description": "shadcn-compatible clsx + tailwind-merge class composition.",
      "dependencies": [
        "clsx@2.1.1",
        "tailwind-merge@3.6.0"
      ],
      "files": [
        {
          "path": "registry/acongm/lib/ui-cn.ts",
          "type": "registry:lib",
          "target": "@lib/ui-cn.ts"
        }
      ]
    },
    {
      "name": "theme-runtime",
      "type": "registry:lib",
      "title": "Acongm theme runtime",
      "description": "Acongm platform integration: cross-subdomain light/dark/system persistence via localStorage and .acongm.com cookie.",
      "files": [
        {
          "path": "registry/acongm/lib/theme.ts",
          "type": "registry:lib",
          "target": "@lib/theme.ts"
        }
      ]
    },
