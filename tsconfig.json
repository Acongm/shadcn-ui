{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["registry/acongm/lib/*"],
      "@/components/ui/*": ["registry/acongm/ui/*"]
    }
  },
  "include": [
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
